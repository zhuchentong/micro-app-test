  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run check && vp run -r test && vp run build",
    "dev": "vp run -r dev",
    "dev:host": "vp run host#dev",
    "dev:sub-a": "vp run sub-app-a#dev",
    "dev:sub-b": "vp run sub-app-b#dev",
    "build": "vp -C apps/host build && vp -C apps/sub-app-a build && vp -C apps/sub-app-b build && vp -C packages/utils pack",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@vizejs/vite-plugin": "catalog:",
